{
  "openapi": "3.1.0",
  "info": {
    "title": "osm-route-details",
    "description": "Elevation and typology (structure, surface) along a route.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "operationId": "getHealthLive",
        "responses": {
          "200": {
            "description": "Process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe",
        "description": "Ready when the configured local data is readable; remote sources are not checked.",
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Configured data not readable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/v1/attribution": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Data attributions",
        "description": "Full attributions of the configured data sources, to be relayed to end users.",
        "operationId": "getAttribution",
        "responses": {
          "200": {
            "description": "Attributions of the configured sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttributionDoc"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Service capabilities",
        "description": "Input bounds, applied defaults, option bounds, enum values, data capabilities and elevation sources.",
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "Service capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          }
        }
      }
    },
    "/v1/route-details": {
      "post": {
        "tags": [
          "route"
        ],
        "summary": "Compute elevation and typology along a route",
        "description": "Validates the route and its options before any computation. Unknown keys, out-of-bounds options and coordinates outside the Web Mercator range give a 400 that lists every faulty field by JSON pointer; input bounds give a 413 with `details.limit`.",
        "operationId": "postRouteDetails",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteDetailsRequestV1"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Invalid input (format, unknown keys, bounds)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "413": {
            "description": "Route too large (`details.limit`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "422": {
            "description": "No data from any source on the route",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "503": {
            "description": "Data unavailable or overloaded (`Retry-After`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "504": {
            "description": "Request budget exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attribution": {
        "type": "object",
        "description": "Attribution of a configured source.",
        "required": [
          "source",
          "short",
          "licence"
        ],
        "properties": {
          "licence": {
            "type": "string"
          },
          "short": {
            "type": "string",
            "description": "Short notice to display."
          },
          "source": {
            "$ref": "#/components/schemas/SourceId"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AttributionDoc": {
        "type": "object",
        "description": "Body of `/v1/attribution`.",
        "required": [
          "text",
          "sources"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attribution"
            }
          },
          "text": {
            "type": "string",
            "description": "Short notice to display, covering every configured source."
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "api_version",
          "rules_version",
          "limits",
          "defaults",
          "option_bounds",
          "enums",
          "primary_zone",
          "data",
          "elevation_sources"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/DataFeatures"
          },
          "defaults": {
            "$ref": "#/components/schemas/OptionDefaults",
            "description": "Values applied when an option is absent."
          },
          "elevation_sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataVersion"
            },
            "description": "Configured elevation sources, in priority order."
          },
          "enums": {
            "$ref": "#/components/schemas/EnumCatalog"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "option_bounds": {
            "$ref": "#/components/schemas/OptionBounds"
          },
          "primary_zone": {
            "type": "string"
          },
          "rules_version": {
            "type": "string"
          }
        }
      },
      "DataFeatures": {
        "type": "object",
        "description": "Capabilities of the active data sources.",
        "required": [
          "ford_detectable",
          "surface_detail",
          "bridge_dsm",
          "heuristics"
        ],
        "properties": {
          "bridge_dsm": {
            "type": "boolean"
          },
          "ford_detectable": {
            "type": "boolean"
          },
          "heuristics": {
            "type": "boolean"
          },
          "surface_detail": {
            "type": "boolean"
          }
        }
      },
      "DataVersion": {
        "type": "object",
        "description": "Version of a data source.",
        "required": [
          "source",
          "role",
          "indicative"
        ],
        "properties": {
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "indicative": {
            "type": "boolean",
            "description": "Source read online: the version is indicative only."
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "$ref": "#/components/schemas/SourceRole"
          },
          "source": {
            "type": "string"
          },
          "zoom": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ElevationDefaults": {
        "type": "object",
        "required": [
          "smoothing_m",
          "gain_preset"
        ],
        "properties": {
          "gain_preset": {
            "$ref": "#/components/schemas/GainPreset"
          },
          "smoothing_m": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ElevationOptionsV1": {
        "type": "object",
        "properties": {
          "gain_preset": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GainPreset",
                "description": "Default: `dem`."
              },
              {
                "type": "null"
              }
            ]
          },
          "smoothing_m": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "0 (disabled) or within the published bounds, in metres."
          }
        }
      },
      "EnumCatalog": {
        "type": "object",
        "description": "Every public value of the contract enums.",
        "required": [
          "sections",
          "sampling_modes",
          "gain_presets",
          "status",
          "structure",
          "structure_source",
          "surface_class",
          "surface_source",
          "way_kind",
          "ele_method",
          "terrain_origin",
          "point_origin",
          "breakpoint_reasons",
          "structure_method",
          "structure_correction_status",
          "warning_codes",
          "problem_codes"
        ],
        "properties": {
          "breakpoint_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ele_method": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gain_presets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GainPreset"
            }
          },
          "point_origin": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "problem_codes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemCode"
            }
          },
          "sampling_modes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SamplingModeV1"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SectionV1"
            }
          },
          "status": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "structure": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "structure_correction_status": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "structure_method": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "structure_source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "surface_class": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "surface_source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terrain_origin": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TerrainOrigin"
            }
          },
          "warning_codes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WarningCode"
            }
          },
          "way_kind": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "FieldError": {
        "type": "object",
        "description": "Error on an input field: a JSON pointer, never the value.",
        "required": [
          "pointer",
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "pointer": {
            "type": "string",
            "description": "JSON pointer (RFC 6901) to the faulty field."
          }
        }
      },
      "GainPreset": {
        "type": "string",
        "description": "Elevation gain preset: threshold and smoothing scale of the gain computation.",
        "enum": [
          "raw",
          "dem",
          "barometric",
          "gps"
        ]
      },
      "HealthStatus": {
        "type": "object",
        "description": "Liveness status.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LimitKind": {
        "type": "string",
        "description": "Input bound exceeded (413).",
        "enum": [
          "points",
          "length_m",
          "body_bytes"
        ]
      },
      "Limits": {
        "type": "object",
        "description": "Input bounds; beyond them, the request gets a 413.",
        "required": [
          "max_points",
          "max_length_m",
          "max_body_bytes",
          "station_step_m",
          "densified_max"
        ],
        "properties": {
          "densified_max": {
            "type": "integer",
            "description": "Maximum number of internal stations implied by the bounds; not a bound itself.",
            "minimum": 0
          },
          "max_body_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "max_length_m": {
            "type": "number",
            "format": "double"
          },
          "max_points": {
            "type": "integer",
            "minimum": 0
          },
          "station_step_m": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "NumberBounds": {
        "type": "object",
        "required": [
          "min",
          "max",
          "default"
        ],
        "properties": {
          "default": {
            "type": "number",
            "format": "double"
          },
          "max": {
            "type": "number",
            "format": "double"
          },
          "min": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "OptionBounds": {
        "type": "object",
        "required": [
          "step_m",
          "smoothing_m"
        ],
        "properties": {
          "smoothing_m": {
            "$ref": "#/components/schemas/NumberBounds",
            "description": "`0` disables smoothing; otherwise within [min, max]."
          },
          "step_m": {
            "$ref": "#/components/schemas/NumberBounds"
          }
        }
      },
      "OptionDefaults": {
        "type": "object",
        "required": [
          "sections",
          "sampling",
          "elevation",
          "structure_correction",
          "accept_partial",
          "debug"
        ],
        "properties": {
          "accept_partial": {
            "type": "boolean"
          },
          "debug": {
            "type": "boolean"
          },
          "elevation": {
            "$ref": "#/components/schemas/ElevationDefaults"
          },
          "sampling": {
            "$ref": "#/components/schemas/SamplingDefaults"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SectionV1"
            }
          },
          "structure_correction": {
            "type": "boolean"
          }
        }
      },
      "OptionsV1": {
        "type": "object",
        "properties": {
          "accept_partial": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Default: `false`."
          },
          "debug": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Internal use only; refused unless the deployment allows it."
          },
          "elevation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ElevationOptionsV1"
              },
              {
                "type": "null"
              }
            ]
          },
          "sampling": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SamplingV1"
              },
              {
                "type": "null"
              }
            ]
          },
          "sections": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/SectionV1"
            },
            "description": "Response sections to return; default: all."
          },
          "structure_correction": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Default: `true`."
          }
        }
      },
      "PointV1": {
        "type": "object",
        "description": "Input point; an optional altitude (`ele` or `alt`) is accepted and ignored.",
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "alt": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Ignored."
          },
          "ele": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Ignored."
          },
          "lat": {
            "type": "number",
            "format": "double",
            "maximum": 85.05112878,
            "minimum": -85.05112878
          },
          "lon": {
            "type": "number",
            "format": "double",
            "maximum": 180,
            "minimum": -180
          }
        }
      },
      "ProblemBody": {
        "type": "object",
        "description": "`application/problem+json` body (RFC 9457).",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "detail": {
            "type": "string"
          },
          "details": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProblemDetails"
              },
              {
                "type": "null"
              }
            ]
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request identifier (`X-Request-Id`)."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "`urn:osm-route-details:problem:<code>`."
          }
        }
      },
      "ProblemCode": {
        "type": "string",
        "description": "Stable machine code, suffix of `type`.",
        "enum": [
          "invalid_input",
          "route_too_large",
          "out_of_coverage",
          "data_unavailable",
          "overloaded",
          "timeout",
          "internal",
          "not_found",
          "method_not_allowed",
          "unsupported_media_type"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "errors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "limit": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LimitKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProblemSource"
              },
              {
                "type": "null"
              }
            ]
          },
          "unknown_keys": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "JSON pointers of every unknown key."
          }
        }
      },
      "ProblemSource": {
        "type": "string",
        "description": "Failing side of a 503 `data_unavailable`.",
        "enum": [
          "typology",
          "elevation",
          "both"
        ]
      },
      "Readiness": {
        "type": "object",
        "description": "Observed state of the configured local data.",
        "required": [
          "ready",
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            }
          },
          "ready": {
            "type": "boolean"
          }
        }
      },
      "ReadinessCheck": {
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "RouteDetailsRequestV1": {
        "type": "object",
        "description": "Body of `POST /v1/route-details`: exactly one of `points` or `polyline`.",
        "properties": {
          "options": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OptionsV1"
              },
              {
                "type": "null"
              }
            ]
          },
          "points": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/PointV1"
            },
            "description": "Route points, in travel order."
          },
          "polyline": {
            "type": [
              "string",
              "null"
            ],
            "description": "Encoded polyline (Google algorithm), at precision `polyline_precision`."
          },
          "polyline_precision": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Precision of `polyline` (5 or 6); required with `polyline`, refused with `points`.",
            "maximum": 6,
            "minimum": 5
          }
        }
      },
      "SamplingDefaults": {
        "type": "object",
        "required": [
          "mode",
          "step_m"
        ],
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/SamplingModeV1"
          },
          "step_m": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SamplingModeV1": {
        "type": "string",
        "enum": [
          "input_with_breakpoints",
          "input",
          "distance"
        ]
      },
      "SamplingV1": {
        "type": "object",
        "properties": {
          "mode": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SamplingModeV1",
                "description": "Default: `input_with_breakpoints`."
              },
              {
                "type": "null"
              }
            ]
          },
          "step_m": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Profile step in `distance` mode, in metres (bounds: `/v1/capabilities`)."
          }
        }
      },
      "SectionV1": {
        "type": "string",
        "enum": [
          "elevation",
          "typology",
          "summary"
        ]
      },
      "SourceId": {
        "type": "string",
        "enum": [
          "streets",
          "ign_dtm",
          "ign_dsm",
          "mapterhorn",
          "mapterhorn_coverage"
        ]
      },
      "SourceRole": {
        "type": "string",
        "enum": [
          "primary",
          "fallback",
          "coverage"
        ]
      },
      "TerrainOrigin": {
        "type": "string",
        "description": "Origin of the terrain data.",
        "enum": [
          "ign_lidar_hd",
          "mapterhorn_measured",
          "mapterhorn",
          "none"
        ]
      },
      "WarningCode": {
